                      </div>
                    )}
                  </div>

                  {hubStatus && (
                    <div className="p-4 bg-amber-500/10 border border-amber-500/20 text-amber-400 rounded-xl text-sm font-medium mt-6">
                      {hubStatus}
                    </div>
