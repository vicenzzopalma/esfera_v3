        var localId = prefs.getString("device_id", null)
        if (localId == null) {
            localId = "LOCAL-${UUID.randomUUID()}"
            prefs.edit().putString("device_id", localId).apply()
        }
        return localId
    }

    fun getServerUrl(): String? {
