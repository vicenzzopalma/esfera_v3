                created_at: row.get(5)?,
                device_count: row.get(6).unwrap_or(0),
                user_count: row.get(7).unwrap_or(0),
            })
        });

        match rows {
            Ok(iter) => iter.filter_map(|r| r.ok()).collect(),
            Err(_) => vec![],
