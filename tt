        self.conn().execute(
            "UPDATE ESF_DevicePermissionRequest SET Status = 'approved', ApprovedBy = ?1, ApprovedAt = datetime('now')
             WHERE RequestId = ?2;",
            params![approved_by, request_id],
        ).map_err(|e| e.to_string())?;

        Ok(())
    }

