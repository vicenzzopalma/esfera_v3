        let _ = self.conn().execute(
            "UPDATE ESF_DevicePermissionRequest SET Status = 'ended', EndedAt = datetime('now')
             WHERE AdbDeviceId = ?1 AND Status IN ('approved', 'active') AND RequestId != ?2;",
